/**
 * Wrangler config for chatplayground-relay.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatplayground-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-25",
  "preview_urls": false,
  "observability": {
    "enabled": true
  },

  "vars": {
    "UPSTREAM_CHAT_URL": "https://app.chatplayground.ai/api/chat/azure",
    "UPSTREAM_ORIGIN": "https://web.chatplayground.ai",
    "UPSTREAM_REFERER": "https://web.chatplayground.ai/",
    "UPSTREAM_UPLOAD_URL": "https://temp-file-host.chatplayground.ai/upload",
    "CLERK_FAPI_URL": "https://clerk.chatplayground.ai"

    // Uncomment once the account has premium access — exposes the 12
    // premiumOnly models in /v1/models. Without it they 403 upstream.
    // ,"PREMIUM_MODELS": "true"
  },

  // Two things live here. The model registry, so a cold isolate doesn't refetch
  // the feed. And — the reason this binding is not optional in practice — the
  // rotated Clerk `__client` cookie: a rotation has nowhere else to persist, so
  // without KV gateway mode dies the moment Clerk issues a replacement and the
  // cookie has to be re-captured by hand (see utils/clerk-token.ts).
  "kv_namespaces": [
    { "binding": "MODEL_CACHE", "id": "a0075251c12d4ae89ff4a73dbc571827" }
  ]
}
