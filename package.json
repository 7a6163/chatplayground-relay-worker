{
  "name": "chatplayground-relay",
  "version": "0.2.0",
  "description": "OpenAI-compatible Cloudflare Worker relay for chatplayground.ai (BYOK, stateless)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests",
    "lint": "oxlint src",
    "check": "npm run format:check && npm run lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "chatplayground",
    "openai",
    "relay"
  ],
  "license": "MIT",
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@vitest/coverage-v8": "^5.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
